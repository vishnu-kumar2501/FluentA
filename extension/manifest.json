{
  "manifest_version": 3,
  "name": "FluentA — AI Writing & Grammar Assistant",
  "version": "1.0.0",
  "description": "Native, high-speed, privacy-first AI writing assistant. Fix grammar, elevate tone, and rewrite text across any website.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "FluentA AI Assistant"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_end"
    }
  ],
  "permissions": [
    "storage",
    "activeTab",
    "contextMenus",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://fluenta-proxy.kumarvishnu610.workers.dev/*",
    "https://api.groq.com/*",
    "http://127.0.0.1:11434/*",
    "http://localhost:11434/*"
  ],
  "commands": {
    "proofread_selection": {
      "suggested_key": {
        "default": "Alt+G",
        "mac": "Alt+G"
      },
      "description": "Proofread or rewrite selected text with FluentA"
    }
  }
}
